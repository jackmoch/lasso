# E2E Test Environment Configuration
# This file is used when running Playwright E2E tests locally
# It points the backend to the mock Last.fm server

# Mock Last.fm API endpoints (started by Playwright global setup)
LASTFM_API_BASE_URL=http://localhost:3456
LASTFM_AUTH_URL=http://localhost:3456

# Test API credentials (mock server accepts any values)
LASTFM_API_KEY=test-api-key
LASTFM_API_SECRET=test-api-secret

# OAuth callback
OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/callback

# Session configuration
SESSION_SECRET=test-session-secret-for-e2e-testing

# Server configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=test

# Polling interval (faster for tests)
POLLING_INTERVAL_MS=2000
