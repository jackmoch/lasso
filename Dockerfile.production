# Production Dockerfile - Assumes artifacts are pre-built
# Build artifacts first: bb build
# Then build image: docker build -f Dockerfile.production -t lasso .

FROM eclipse-temurin:11-jre-alpine

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S lasso && \
    adduser -u 1001 -S lasso -G lasso

# Copy pre-built JAR
COPY target/lasso.jar ./lasso.jar

# Copy pre-built frontend assets
COPY resources/public/js ./resources/public/js
COPY resources/public/css/tailwind.css ./resources/public/css/tailwind.css
COPY resources/public/index.html ./resources/public/index.html

# Set ownership
RUN chown -R lasso:lasso /app

USER lasso

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Run the application
CMD ["java", "-jar", "lasso.jar"]
