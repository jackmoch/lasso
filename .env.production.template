# Production Environment Configuration Template
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production with real credentials to version control

# =============================================================================
# Last.fm API Configuration
# =============================================================================
# Get your API credentials at: https://www.last.fm/api/account/create

# Last.fm API Key (public identifier)
LASTFM_API_KEY=your_production_api_key_here

# Last.fm API Secret (keep secret!)
LASTFM_API_SECRET=your_production_api_secret_here

# Last.fm API endpoints (production uses real Last.fm API)
LASTFM_API_BASE_URL=https://ws.audioscrobbler.com
LASTFM_AUTH_URL=https://www.last.fm

# =============================================================================
# OAuth Configuration
# =============================================================================
# OAuth callback URL - must match your registered application callback
# For Cloud Run: https://your-app.run.app/api/auth/callback
# For custom domain: https://yourdomain.com/api/auth/callback
OAUTH_CALLBACK_URL=https://your-production-domain.run.app/api/auth/callback

# =============================================================================
# Session Security
# =============================================================================
# Session secret for encrypting session data
# CRITICAL: Generate a strong random secret (32+ characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_32_CHARS_MINIMUM

# Session cookie configuration
SESSION_COOKIE_NAME=lasso-session
SESSION_COOKIE_MAX_AGE=86400000
# Session cookie security (true in production for HTTPS)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# =============================================================================
# Server Configuration
# =============================================================================
# Server host and port
# Cloud Run sets PORT automatically, but you can specify default
HOST=0.0.0.0
PORT=8080

# Environment name
ENVIRONMENT=production

# =============================================================================
# Application Configuration
# =============================================================================
# Polling interval for checking scrobbles (milliseconds)
# Production: 20000ms (20 seconds) respects Last.fm rate limits
POLLING_INTERVAL_MS=20000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Log format: json (for structured logging in production)
LOG_FORMAT=json

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (comma-separated)
# For production, specify your exact domain(s)
CORS_ALLOWED_ORIGINS=https://your-production-domain.run.app

# CORS credentials support
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Google Cloud Run Configuration (Optional)
# =============================================================================
# These are typically set automatically by Cloud Run, but can be overridden

# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Cloud Run service name
SERVICE_NAME=lasso

# Cloud Run region
GCP_REGION=us-central1

# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Cloud Logging (enabled by default on Cloud Run)
# GCP_LOGGING_ENABLED=true

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# Enable/disable features in production
FEATURE_MANUAL_BACKFILL=false
FEATURE_MULTIPLE_SESSIONS=false

# =============================================================================
# Security Headers (Optional - can be configured in code)
# =============================================================================
# Content Security Policy
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# =============================================================================
# Notes
# =============================================================================
# 1. NEVER commit this file with real values to version control
# 2. Add .env.production to .gitignore (already done)
# 3. Use Google Secret Manager for sensitive values in Cloud Run
# 4. Rotate SESSION_SECRET regularly
# 5. Use strong, unique values for all secrets
# 6. Test locally before deploying: cp .env.production .env && bb build
