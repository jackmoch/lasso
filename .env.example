# Last.fm API Configuration
# Get your API credentials from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_api_key_here
LASTFM_API_SECRET=your_api_secret_here

# OAuth Configuration
# Update this to match your deployment environment
OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/callback

# Session Security
# Generate a random string (minimum 32 characters)
# Example: openssl rand -hex 32
SESSION_SECRET=your_random_secret_minimum_32_characters

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Polling Configuration
# Interval between Last.fm API polls (milliseconds)
# Recommended: 15000-30000 (respect 5 req/sec rate limit)
POLLING_INTERVAL_MS=20000

# Admin Dashboard
# Credentials for the /admin operator console
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
# Admin session inactivity timeout (ms). Default: 28800000 = 8 hours
# ADMIN_SESSION_TTL_MS=28800000

# Firestore / Persistence (optional — app runs without it)
# GCP project ID. Defaults to lasso-scrobbler-0667 if unset.
# GOOGLE_CLOUD_PROJECT=lasso-scrobbler-0667
#
# For local development, authenticate with ADC (one-time):
#   gcloud auth application-default login
#
# Collection prefix is derived automatically from ENVIRONMENT:
#   development → "dev-"  (e.g. dev-users, dev-remember_tokens)
#   staging     → "staging-"
#   production  → "" (no prefix)
#
# Cloud Run uses the attached service account automatically (no key file needed).
